# Local PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL="Host=localhost;Port=5432;Database=taskflow;Username=taskflow;Password=change-this-local-password"

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=TaskFlow.Api
JWT_AUDIENCE=TaskFlow.Web
JWT_ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Optional one-time admin bootstrap secret. Leave unset after first admin is created.
BOOTSTRAP_ADMIN_TOKEN=
VITE_API_BASE_URL=/api
